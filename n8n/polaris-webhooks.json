    {
      "parameters": {
        "jsCode": "// Eingabe: { type, text, summary?, tags?, importance?, source? }\nconst b = $json.body || {};\nconst TYPES = ['conversation','note','fact','preference'];\nconst type = TYPES.includes(b.type) ? b.type : 'fact';\nconst text = String(b.text || '').slice(0, 8000);\nif (!text) throw new Error('memory-save: text fehlt');\nconst tags = Array.isArray(b.tags) ? b.tags.map(t => String(t).toLowerCase().slice(0, 40)).slice(0, 8) : [];\nlet importance = Number(b.importance);\nif (!isFinite(importance)) importance = 2;\nimportance = Math.max(1, Math.min(5, Math.round(importance)));\nconst entry = {\n  ts: Date.now(),\n  type, text,\n  summary: String(b.summary || '').slice(0, 500),\n  tags, importance,\n  source: b.source === 'system' ? 'system' : 'voice'\n};\nreturn [{ json: { entry } }];"
      },
