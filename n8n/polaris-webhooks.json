      "parameters": {
        "jsCode": "// Gespraechseinstieg aus openLoops, offenen Notizen und Tageszeit.\nfunction parse(node){ try { return JSON.parse(node || 'null') || {}; } catch(e){ return {}; } }\nconst rel = parse($('Beziehung lesen').first().json.data);\nconst notesRaw = parse($json.data);\nconst openNotes = Object.values(notesRaw).filter(n => n && n.done === false);\nconst h = Number(new Intl.DateTimeFormat('de-CH', { timeZone: 'Europe/Zurich', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));\nconst gruss = h < 5 ? 'Nachtschicht, Laurin?' : h < 11 ? 'Guten Morgen, Laurin' : h < 18 ? 'Hallo Laurin' : 'Guten Abend, Laurin';\nconst loops = Array.isArray(rel.openLoops) ? rel.openLoops : [];\nlet teil;\nif (loops.length) teil = 'Offen geblieben war: „' + String(loops[0]).slice(0, 100) + '“ — wie sieht es damit aus?';\nelse if (openNotes.length) teil = 'Du hast ' + openNotes.length + ' offene Notiz' + (openNotes.length === 1 ? '' : 'en') + ' — soll ich sie kurz durchgehen?';\nelse if (Number(rel.streak) >= 3) teil = 'Tag ' + rel.streak + ' in Folge — Kurs halten. Was steht an?';\nelse teil = 'Was steht heute an?';\nreturn [{ json: { opener: gruss + '. ' + teil } }];"
