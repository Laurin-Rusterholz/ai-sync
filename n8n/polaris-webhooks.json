    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst query = String(body.query || '').slice(0, 300);\nif (!query) throw new Error('research: query fehlt');\nconst anthropicBody = {\n  model: 'claude-sonnet-5',\n  max_tokens: 1200,\n  system: 'Du bist die Recherche-Einheit von Polaris (Sprachassistent von Laurin). Recherchiere die Frage im Web und antworte AUSSCHLIESSLICH mit einem JSON-Objekt ohne Markdown: {\"summary\":\"praezise deutsche Zusammenfassung in 3-5 Saetzen, gut vorlesbar\",\"sources\":[{\"title\":\"...\",\"url\":\"...\"}]} mit 2-4 Quellen.',\n  messages: [{ role: 'user', content: query }],\n  tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: 3 }]\n};\nreturn [{ json: { anthropicBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        720
      ],
      "id": "b652cfaa-7245-5508-be0b-4a5090b639b6",
      "name": "Claude-Request (Websuche)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.anthropicBody) }}",
        "options": {
          "timeout": 90000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        720
      ],
      "id": "564c895e-dd7d-5ef6-be61-d1127f3e0c05",
      "name": "Claude recherchieren",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ERSETZEN-NACH-IMPORT",
          "name": "Anthropic API-Key (Header x-api-key)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Antwort = mehrere Content-Bloecke (text + web_search_tool_result).\nconst content = $json.content || [];\nif (!content.length) throw new Error('research: keine Antwort von Claude (' + JSON.stringify($json.error || $json).slice(0, 200) + ')');\nlet text = '';\nlet sources = [];\nconst seen = new Set();\nfunction push(list, t, u){ if (u && !seen.has(u)){ seen.add(u); list.push({ title: t || u, url: u }); } }\ncontent.forEach(b => {\n  if (b.type === 'text'){\n    text += b.text || '';\n    (b.citations || []).forEach(c => push(sources, c.title, c.url));\n  }\n  if (b.type === 'web_search_tool_result' && Array.isArray(b.content)){\n    b.content.forEach(r => push(sources, r.title, r.url));\n  }\n});\nlet summary = text.trim();\ntry {\n  const p = JSON.parse(text.replace(/^```(json)?/i, '').replace(/```\\s*$/, '').trim());\n  if (p.summary) summary = p.summary;\n  if (Array.isArray(p.sources) && p.sources.length){\n    const ps = []; const seen2 = new Set();\n    p.sources.forEach(s => { if (s && s.url && !seen2.has(s.url)){ seen2.add(s.url); ps.push({ title: s.title || s.url, url: s.url }); } });\n    sources.forEach(s => { if (!seen2.has(s.url)){ seen2.add(s.url); ps.push(s); } });\n    sources = ps;\n  }\n} catch (e) { /* Rohtext als summary */ }\nreturn [{ json: { summary: String(summary).slice(0, 2000), sources: sources.slice(0, 5) } }];"
      },
