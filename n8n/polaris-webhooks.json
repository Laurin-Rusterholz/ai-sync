    {
      "parameters": {
        "jsCode": "// Volltext-/Tag-Suche ueber memory + notes, relevanteste zuerst.\nconst body = $('Webhook memory-recall').first().json.body || {};\nconst query = String(body.query || '').toLowerCase();\nconst limit = Math.max(1, Math.min(20, Number(body.limit) || 5));\nconst tokens = query.split(/[^a-zäöüéèàß0-9]+/).filter(t => t.length >= 3);\nfunction parse(node){ try { return JSON.parse(node || 'null') || {}; } catch(e){ return {}; } }\nconst memRaw = parse($('Memory lesen').first().json.data);\nconst noteRaw = parse($json.data);\nconst items = [];\nObject.keys(memRaw).forEach(k => { const m = memRaw[k]; if (m && m.text != null) items.push(Object.assign({ id: k }, m)); });\nObject.keys(noteRaw).forEach(k => { const n = noteRaw[k]; if (n && n.text != null) items.push({ id: k, type: 'note', ts: n.ts, text: n.text, summary: '', tags: n.tags || [], importance: 2, done: n.done }); });\nconst now = Date.now();\nitems.forEach(it => {\n  const hay = ((it.text || '') + ' ' + (it.summary || '') + ' ' + (it.tags || []).join(' ')).toLowerCase();\n  let s = 0;\n  tokens.forEach(t => { if (hay.includes(t)) s += 3; });\n  s += Math.min(2, Number(it.importance) || 0) * 0.5;\n  const ageDays = (now - (Number(it.ts) || 0)) / 86400000;\n  s += Math.max(0, 2 - ageDays / 30); // Rezenz-Bonus\n  it._score = s;\n});\nitems.sort((a, b) => b._score - a._score);\nconst top = items.slice(0, limit).map(it => { const c = Object.assign({}, it); delete c._score; return c; });\nreturn [{ json: { items: top } }];"
      },
