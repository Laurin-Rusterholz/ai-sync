    {
      "parameters": {
        "jsCode": "// Claude-Fehler (onError continue) => Client-summary bleibt stehen.\nconst entry = $('Memory normalisieren').first().json.entry;\ntry {\n  const txt = ((($json.content || [])[0]) || {}).text || '';\n  const parsed = JSON.parse(txt.replace(/^```(json)?/i, '').replace(/```\\s*$/, '').trim());\n  if (parsed.summary) entry.summary = String(parsed.summary).slice(0, 500);\n  if (Array.isArray(parsed.tags) && parsed.tags.length) entry.tags = parsed.tags.map(t => String(t).toLowerCase().slice(0, 40)).slice(0, 8);\n} catch (e) { /* Heuristik behalten */ }\nreturn [{ json: { entry } }];"
