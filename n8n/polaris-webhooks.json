      "parameters": {
        "jsCode": "// LLM-Zusammenfassung ersetzt die Client-Heuristik (nur type=conversation).\nconst entry = $json.entry;\nconst anthropicBody = {\n  model: 'claude-sonnet-5',\n  max_tokens: 400,\n  system: 'Du fasst Sprach-Gespraeche zwischen Laurin und seinem Assistenten Polaris zusammen. Antworte AUSSCHLIESSLICH mit einem JSON-Objekt ohne Markdown: {\"summary\":\"2-3 praegnante deutsche Saetze (was besprochen, was entschieden, was offen blieb)\",\"tags\":[\"3-6 kleingeschriebene schlagworte\"]}',\n  messages: [{ role: 'user', content: 'Transkript:\\n' + entry.text }]\n};\nreturn [{ json: { entry, anthropicBody } }];"
