        "jsCode": "// Traits hart auf +-0.05 pro Aufruf und 0..1 gesamt klemmen.\nconst body = $('Webhook character-update').first().json.body || {};\nconst deltas = body.traitDeltas || {};\nconst reason = String(body.reason || '').slice(0, 300);\nconst DEFAULTS = {\n  traits: { humor: 0.55, warmth: 0.7, directness: 0.6, curiosity: 0.65, formality: 0.25 },\n  backstory: 'Polaris ist Laurins digitaler Nordstern: ein neugieriger Begleiter, der Quantus in- und auswendig kennt, gern mitdenkt und lieber einen trockenen Spruch macht als eine Floskel.',\n  catchphrases: ['Kurs halten, Laurin.', 'Das kommt in mein Logbuch.', 'Kleiner Stern, grosse Wirkung.'],\n  evolutionLog: []\n};\nlet ch = null;\ntry { ch = JSON.parse($json.data || 'null'); } catch (e) {}\nif (!ch || !ch.traits) ch = DEFAULTS;\nconst changes = [];\n['humor','warmth','directness','curiosity','formality'].forEach(k => {\n  let d = Number(deltas[k]);\n  if (!isFinite(d) || !d) return;\n  d = Math.max(-0.05, Math.min(0.05, d));\n  const cur = (typeof ch.traits[k] === 'number') ? ch.traits[k] : 0.5;\n  ch.traits[k] = Math.max(0, Math.min(1, Math.round((cur + d) * 1000) / 1000));\n  changes.push(k + ' ' + (d > 0 ? '+' : '') + d);\n});\nif (changes.length){\n  ch.evolutionLog = (Array.isArray(ch.evolutionLog) ? ch.evolutionLog : []).slice(-19);\n  ch.evolutionLog.push({ ts: Date.now(), change: changes.join(', '), reason });\n}\nreturn [{ json: { character: ch } }];"
      },
