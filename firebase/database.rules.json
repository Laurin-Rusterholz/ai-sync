{
  "rules": {

    "appStore": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "driveInbox": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status"]
    },
    "communicator_inbox": {
      ".read": true,
      ".write": true
    },
    "quantus_task_inbox": {
      ".read": true,
      ".write": true
    },

    "nobraine": {
      ".read": true,
      ".write": true,
      "recipes": {
        ".indexOn": ["kategorie", "lastUsed"]
      }
    },

    "$andere": {
      ".read": true,
      ".write": true
    }
  }
}
