{
    "rules": {
          "driveFolders": {
                  ".read": true,
                  ".write": true
          },
          "driveDocs": {
                  ".read": true,
                  ".write": true
          },
          "driveInbox": {
                  ".read": true,
                  ".write": true,
                  ".indexOn": ["status"]
          },
          "nobraine": {
                  ".read": "auth != null",
                  ".write": "auth != null",
                  "recipes": {
                          ".indexOn": ["kategorie", "lastUsed"]
                  }
          },
          "$andere": {
                  ".read": true,
                  ".write": true
          }
    }
}
