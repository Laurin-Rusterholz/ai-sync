# Kopiere diese Datei nach ~/neko/.env auf dem VPS und trage die echten
# Passwoerter ein (siehe sichere Uebergabe / Report). NICHT ins Git committen.
#
# WICHTIG: NEKO_USER_PASSWORD muss exakt dem QUANTUS_BROWSER_PW in
# public/index.html entsprechen (Auto-Login-Link).
NEKO_USER_PASSWORD=CHANGE_ME_user
NEKO_ADMIN_PASSWORD=CHANGE_ME_admin
