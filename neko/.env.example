# Quantus Browser — Serverseitige Konfiguration.
#
# Diese Datei ist NUR eine Vorlage. Auf dem VPS liegt die echte Datei unter
# /opt/quantus-neko/.env und wird NIE ins Git committet (siehe .gitignore).
# Es stehen hier bewusst keine echten Passwoerter — auch keine "Beispiel"-
# Passwoerter, die spaeter versehentlich uebernommen werden.
#
# Das Deploy-Skript legt die .env beim ersten Lauf mit frischen Zufallswerten an
# (openssl rand -base64 24), zeigt das User-Passwort genau einmal an und pflegt
# danach nur noch einzelne Schluessel — vorhandene Werte bleiben unangetastet.

# ── Pflicht ───────────────────────────────────────────────────────────────────
# Passwort fuer den taeglichen Zugang (wird im neko-Login eingegeben).
NEKO_USER_PASSWORD=
# Admin-Passwort (Aufloesung aendern, Nutzer verwalten). Bleibt serverseitig.
NEKO_ADMIN_PASSWORD=
# Oeffentliche IPv4 des VPS fuer WebRTC NAT 1:1 (kein Geheimnis).
NEKO_PUBLIC_IP=82.180.155.81

# ── Compose-Auswahl (setzt das Deploy-Skript automatisch) ─────────────────────
# Laeuft ein Traefik im Docker (wie beim bestehenden n8n-Stack), wird das
# Overlay mit den Traefik-Labels dazugeladen. Sonst steht hier nur die
# Basisdatei. Ein blosses `docker compose up -d` in /opt/quantus-neko nutzt
# dadurch automatisch die richtige Kombination.
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# Eigenes Compose-Projekt — strikt getrennt vom bestehenden Projekt "n8n".
COMPOSE_PROJECT_NAME=quantus-neko

# ── Traefik (nur relevant, wenn ein Traefik im Docker laeuft) ─────────────────
# Bereits vorhandenes Netz, an das sich neko anhaengt. Es wird KEIN neues Netz
# erzeugt und das n8n-Compose nicht angefasst.
NEKO_TRAEFIK_NETWORK=n8n_default
# Name des ACME-Resolvers aus der Traefik-Konfiguration.
NEKO_TRAEFIK_CERTRESOLVER=mytlschallenge
# Namen der EntryPoints (Traefik-Standard: web = :80, websecure = :443).
NEKO_TRAEFIK_ENTRYPOINT_HTTP=web
NEKO_TRAEFIK_ENTRYPOINT_HTTPS=websecure
# Domain fuer die Router-Regel Host(`…`).
NEKO_DOMAIN=neko.laurin-rusterholz.ch

# ── Optional (Defaults siehe docker-compose.yml) ──────────────────────────────
# Gepinnte Image-Version. Update nur bewusst aendern, danach:
#   bash /opt/ai-sync/scripts/deploy-neko-hostinger.sh --update
NEKO_IMAGE_TAG=3.1.5
# Interner HTTP-Port (nur an 127.0.0.1 gebunden — fuer lokale Diagnose).
NEKO_HTTP_PORT=8080
# WebRTC-Port (UDP + TCP-Fallback, gemultiplext). Laeuft an Traefik vorbei
# direkt am Host und muss in der Firewall offen sein.
NEKO_WEBRTC_PORT=59000
# Aufloesung/Bildrate des Remote-Desktops. Hoeher = mehr CPU auf KVM 1.
NEKO_SCREEN=1280x720@30
# Speicherlimit des Containers (KVM 1 hat 4 GB, n8n laeuft daneben).
NEKO_MEM_LIMIT=2600m
# Experimenteller Datei-Auswahl-Dialog. Bei Problemen auf false setzen.
NEKO_FILE_CHOOSER=true
