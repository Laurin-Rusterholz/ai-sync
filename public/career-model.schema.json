{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://management-xo2-pro.netlify.app/career-model.schema.json",
  "title": "Quantus Career Model Import",
  "description": "Versionierter Importvertrag für vollständig vorbereitete, KI-unabhängig nutzbare Weiterbildungsmodule.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "generatedAt", "careerArea", "module"],
  "properties": {
    "schema": { "const": "quantus-career-model/v1" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "careerArea": { "$ref": "#/$defs/careerArea" },
    "module": { "$ref": "#/$defs/module" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "careerArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 3000 }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reference": { "type": "string", "maxLength": 500 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "text", "items", "sourceRefs"],
      "properties": {
        "type": {
          "enum": ["heading", "paragraph", "list", "callout", "example", "case", "checklist"]
        },
        "title": { "type": "string", "maxLength": 180 },
        "text": { "type": "string", "maxLength": 12000 },
        "items": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "anyOf": [
        { "properties": { "text": { "minLength": 1 } } },
        { "properties": { "items": { "minItems": 1 } } }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "estimatedMinutes", "solution"],
      "properties": {
        "prompt": { "$ref": "#/$defs/plainText" },
        "estimatedMinutes": { "type": "integer", "minimum": 2, "maximum": 20 },
        "solution": { "$ref": "#/$defs/plainText" }
      }
    },
    "reviewQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "title", "estimatedMinutes", "objectives", "sections", "exercise", "reviewQuestions", "takeaways"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "day": { "type": "integer", "minimum": 1, "maximum": 180 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "estimatedMinutes": { "type": "integer", "minimum": 15, "maximum": 60 },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        },
        "exercise": { "$ref": "#/$defs/exercise" },
        "reviewQuestions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/reviewQuestion" }
        },
        "takeaways": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "level", "sourceDocuments", "estimatedTotalMinutes", "days"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 6000 },
        "level": { "type": "string", "maxLength": 180 },
        "sourceDocuments": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceDocument" }
        },
        "estimatedTotalMinutes": { "type": "integer", "minimum": 15 },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 180,
          "items": { "$ref": "#/$defs/day" }
        }
      }
    }
  }
}
