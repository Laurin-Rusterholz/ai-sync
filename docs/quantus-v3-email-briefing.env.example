# Quantus — E-Mail-Auswertung fuers Tagesbriefing: Netlify-Importvorlage.
#
# Diese Datei enthaelt AUSSCHLIESSLICH nicht-geheime Konfigurationswerte
# (Modellname, Preise pro Million Token, Mandant, zwei Policy-JSONs) plus
# EINEN Platzhalter fuer den einzigen wirklich geheimen Wert
# (QUANTUS_EMAIL_AUTH_TOKEN) — diesen vor dem Import durch einen echten
# zufaelligen Wert ersetzen, z. B. mit `openssl rand -hex 32`.
#
# Import: Netlify -> Site settings -> Environment variables ->
# "Import from a .env file" -> diese Datei hochladen.
#
# Alle sieben Werte wurden gegen die echten Schema-Validatoren dieses Repos
# geprueft (netlify/lib/assistant-schema.mjs `validatePolicy`,
# netlify/lib/quantus-v3-runtime-state.mjs `validateCostPolicy`) — beide
# JSON-Werte ergeben dort {"ok":true}.

QUANTUS_EMAIL_AUTH_TOKEN=BITTE-DURCH-EINEN-ECHTEN-ZUFALLSWERT-ERSETZEN

QUANTUS_V3_ANTHROPIC_MODEL=claude-sonnet-5
QUANTUS_V3_ANTHROPIC_INPUT_MICROS_PER_MTOK=2000000
QUANTUS_V3_ANTHROPIC_OUTPUT_MICROS_PER_MTOK=10000000
QUANTUS_V3_TENANT=quantus

QUANTUS_V3_TAGESBRIEFING_POLICY_JSON='{"schema":"tagesbriefing-policy/3","version":"1","tenant":"quantus","timezone":"Europe/Zurich","sourceMaxAgeMinutes":15,"evaluationTtlMinutes":15,"deferralLimit":3,"maxWaitDays":30,"requiredSources":[{"id":"quantus-core","kind":"quantus-core"},{"id":"gmail","kind":"mail"}],"noExternalSources":false,"closure":{"earliestLocalTime":"23:00","requiredReceipts":["process09","close23"]},"featureFlags":{"writes":"live","runner":"live","providers":"live"}}'

QUANTUS_V3_COST_POLICY_JSON='{"schema":"quantus-v3-cost-policy/1","version":"1","currency":"USD","approval":{"approvedBy":"Laurin Rusterholz","approvalRef":"email-briefing-2026-09","approvedAtMs":1758000000000},"effectiveFromMs":1758000000000,"effectiveUntilMs":4102444800000,"dayLimitMicros":10000000,"runLimitMicros":5000000,"callLimitMicros":1000000,"unresolvedBlockMicros":5000000,"featureFlags":{"providers":"live"},"models":{"anthropic:claude-sonnet-5":{"inputMicrosPerMillionTokens":2000000,"outputMicrosPerMillionTokens":10000000,"maxCallMicros":1000000}}}'
